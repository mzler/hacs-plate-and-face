# Plate & Face Recognition Add-on – Docker Compose Dockerfile
# Optimiert für schnelle Installation auf ARM (Mac)

FROM python:3.11-slim

# System-Abhängigkeiten (Minimum für OpenCV und dlib-bin)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    liblapack-dev \
    libpng-dev \
    libjpeg-dev \
    libx11-6 \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Schritt 1: Vorkompilierte dlib-bin nutzen (spart 20 Min Kompilierung)
RUN pip install --no-cache-dir dlib-bin>=19.24.2

# Schritt 2: face_recognition OHNE dependencies (da dlib-bin bereits dlib bereitstellt)
RUN pip install --no-cache-dir face_recognition==1.3.0 --no-deps

# Schritt 3: Restliche Abhängigkeiten (inkl. face_recognition_models)
RUN pip install --no-cache-dir \
    face_recognition_models \
    opencv-python-headless==4.9.0.80 \
    easyocr==1.7.1 \
    fastapi==0.111.0 \
    "uvicorn[standard]==0.29.0" \
    python-multipart==0.0.9 \
    "numpy>=1.21.0,<2.0" \
    "Pillow>=9.0.0" \
    click

# Code kopieren
COPY app/ /app/

ENV PFR_DATA_DIR=/data
ENV PORT=8585

# Startbefehl
CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT} --workers 1 --log-level info"]
